AMBIENTE=local

# parquet: arquivos diretos no RustFS, sem catálogo; iceberg: arquitetura alvo.
PIPELINE_STORAGE_FORMAT=iceberg

# Aplicações no host; o Compose substitui endpoints pelo DNS interno.
S3_ENDPOINT=localhost:9000
S3_INTERNAL_ENDPOINT=rustfs:9000
S3_ACCESS_KEY=change-me-writer
S3_SECRET_KEY=change-me-writer-secret
S3_REGION=us-east-1
S3_USE_SSL=false
S3_URL_STYLE=path
RUSTFS_ACCESS_KEY=change-me-admin
RUSTFS_SECRET_KEY=change-me-admin-secret
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001

ICEBERG_CATALOG_ENDPOINT=http://localhost:19120/iceberg
ICEBERG_WAREHOUSE=warehouse
ICEBERG_CATALOG_NAME=lakehouse
NESSIE_PORT=19120
NESSIE_MEMORY=384m
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9002
CLICKHOUSE_MEMORY=576m
CLICKHOUSE_ADMIN_USER=lakehouse_admin
CLICKHOUSE_ADMIN_PASSWORD=change-me-admin-password
CLICKHOUSE_READONLY_PASSWORD=change-me-readonly-password

PREFECT_PORT=4200
PREFECT_API_URL=http://localhost:4200/api
DUCKDB_MEMORY_LIMIT=128MB
DUCKDB_TEMP_DIRECTORY=.prefect/duckdb-tmp

# Limites iniciais, ainda sujeitos à validação real de 2GB (inclusive host).
RUSTFS_MEMORY=192m
PREFECT_SERVER_MEMORY=160m
PREFECT_WORKER_MEMORY=384m
