AMBIENTE=local

# parquet: arquivos diretos no RustFS, sem catálogo; iceberg: arquitetura alvo.
PIPELINE_STORAGE_FORMAT=iceberg

# Aplicações no host; o Compose substitui endpoints pelo DNS interno.
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=change-me-writer
S3_SECRET_KEY=change-me-writer-secret
S3_REGION=us-east-1
S3_USE_SSL=false
S3_URL_STYLE=path
RUSTFS_ACCESS_KEY=change-me-admin
RUSTFS_SECRET_KEY=change-me-admin-secret
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001

ICEBERG_CATALOG_ENDPOINT=http://localhost:8181/api/catalog
ICEBERG_WAREHOUSE=prefect
ICEBERG_CATALOG_NAME=lakehouse
POLARIS_CLIENT_ID=pipeline
POLARIS_CLIENT_SECRET=change-me-generated-by-setup
POLARIS_READER_CLIENT_ID=trino
POLARIS_READER_CLIENT_SECRET=change-me-generated-by-setup
POLARIS_ROOT_CLIENT_ID=root
POLARIS_ROOT_CLIENT_SECRET=change-me-admin-secret
POLARIS_SCOPE=PRINCIPAL_ROLE:ALL
POLARIS_DB_PASSWORD=change-me-db-secret
POLARIS_PORT=8181

PREFECT_PORT=4200
PREFECT_API_URL=http://localhost:4200/api
DUCKDB_MEMORY_LIMIT=128MB
DUCKDB_TEMP_DIRECTORY=.prefect/duckdb-tmp
TRINO_PORT=8080
TRINO_USER=analista
TRINO_PASSWORD=change-me-sql-password

# Limites iniciais, ainda sujeitos à validação real de 2GB (inclusive host).
RUSTFS_MEMORY=192m
POLARIS_MEMORY=320m
POSTGRES_MEMORY=80m
TRINO_MEMORY=576m
PREFECT_SERVER_MEMORY=160m
PREFECT_WORKER_MEMORY=384m
