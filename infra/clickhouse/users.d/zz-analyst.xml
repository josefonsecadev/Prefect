<clickhouse>
  <profiles>
    <default>
      <allow_database_iceberg>1</allow_database_iceberg>
    </default>
    <readonly>
      <readonly>1</readonly>
      <allow_database_iceberg>1</allow_database_iceberg>
      <show_data_lake_catalogs_in_system_tables>1</show_data_lake_catalogs_in_system_tables>
    </readonly>
  </profiles>
  <users>
    <analista>
      <password from_env="CLICKHOUSE_READONLY_PASSWORD"/>
      <networks>
        <ip>0.0.0.0/0</ip>
      </networks>
      <profile>readonly</profile>
      <quota>default</quota>
      <access_management>0</access_management>
    </analista>
  </users>
</clickhouse>
